MONGO_URL=mongodb://localhost:27017
DB_NAME=homefix
JWT_SECRET=replace-with-a-long-random-secret
ENV=development
CORS_ORIGINS=http://localhost:3000

# Initial administrator account (change these before deploying)
ADMIN_EMAIL=admin@homefix.pro
ADMIN_PASSWORD=change-this-password

# Uploaded files are stored here. Relative paths resolve from the backend process.
UPLOAD_DIR=./data/uploads

# Optional email delivery through Resend. Without these, emails are logged.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=HomeFix Pro

# Optional online payments. Cash bookings work without Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
